{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlview.dev/contracts/workflow.schema.json",
  "title": "MLView WorkflowDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflowVersion", "title", "producer", "revision", "request", "phases", "nodes", "edges", "findings", "evidence", "coverage"],
  "properties": {
    "workflowVersion": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "producer": {
      "type": "object", "additionalProperties": false, "required": ["kind", "host"],
      "properties": {
        "kind": {"const": "host-llm"},
        "host": {"enum": ["copilot", "codex", "claude-code", "unknown"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "parent": {"$ref": "#/$defs/id"}}
    },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["question", "scope"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "scope": {"type": "string", "minLength": 1, "maxLength": 2000},
        "entrypoints": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "configuration": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "phases": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/phase"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 4000, "items": {"$ref": "#/$defs/edge"}},
    "findings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/finding"}},
    "evidence": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/evidence"}},
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["status", "summary", "inspectedFiles", "limitations"],
      "properties": {
        "status": {"enum": ["scoped", "partial"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "inspectedFiles": {"type": "array", "maxItems": 2000, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "limitations": {"type": "array", "maxItems": 500, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["files", "publishedAt"],
      "properties": {
        "files": {"type": "object", "maxProperties": 2000, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 500}, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "publishedAt": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "basis": {"enum": ["observed", "inferred", "unresolved"]},
    "refs": {"type": "array", "uniqueItems": true, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
    "phase": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 200}}},
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "phase", "basis", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 300}, "phase": {"$ref": "#/$defs/id"}, "parent": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1, "maxLength": 100}, "detail": {"type": "string", "maxLength": 8000}, "basis": {"$ref": "#/$defs/basis"}, "evidence": {"$ref": "#/$defs/refs"}}
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["id", "source", "target", "label", "basis", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 300}, "kind": {"type": "string", "minLength": 1, "maxLength": 100}, "basis": {"$ref": "#/$defs/basis"}, "evidence": {"$ref": "#/$defs/refs"}}
    },
    "finding": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "message", "severity", "nodeIds", "basis", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1, "maxLength": 300}, "message": {"type": "string", "minLength": 1, "maxLength": 8000}, "severity": {"enum": ["low", "medium", "high"]}, "nodeIds": {"$ref": "#/$defs/refs"}, "edgeIds": {"$ref": "#/$defs/refs"}, "basis": {"$ref": "#/$defs/basis"}, "evidence": {"$ref": "#/$defs/refs"}, "counterEvidence": {"$ref": "#/$defs/refs"}, "suggestion": {"type": "string", "maxLength": 4000}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "file", "line", "endLine", "quote"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "file": {"type": "string", "minLength": 1, "maxLength": 500}, "line": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "maxLength": 16000}, "cell": {"type": "integer", "minimum": 0}}
    }
  }
}
