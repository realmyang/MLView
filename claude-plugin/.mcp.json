{
  "mcpServers": {
    "mlview": {
      "type": "stdio",
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/mlview_mcp.py"],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/vendor",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "MLVIEW_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "MLVIEW_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
