# dependencies and build output
node_modules/
vscode-extension/out/
*.vsix
# PACKAGING: `python -m build --wheel analyzer` (scripts/build.sh step 6) writes both.
analyzer/dist/
analyzer/build/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# PUB-01: `python tools/public_corpus.py fetch` clones ~1.8 GB of pinned public
# repositories into tools/public_corpus.py's DEFAULT_CORPUS_DIR (override it with
# MLVIEW_PUBLIC_CORPUS_DIR). The manifest pins every SHA, so the clones are
# reproducible from analyzer/tests/public_corpus/repos.json and are never
# committed. Without this line a developer who runs `fetch` gets 24 untracked
# repositories in `git status`, and the module docstring's "git-ignored" is false.
.public-corpus/

# generated demo artifacts (scripts/e2e regenerates them)
.mlview/
webview/.mlview/
# MLV-P11: `python analyzer/tools/gen_gallery.py` renders ~90 self-contained reports
# (~30 MB) from the rule fixtures and the clean corpus. Zero new content, so it is
# generated on demand and never committed.
docs/gallery/

# local orchestration backups and scratch
.workflows/backup/
*.log
.DS_Store
Thumbs.db

# local virtual environment (macOS setup)
.venv/
